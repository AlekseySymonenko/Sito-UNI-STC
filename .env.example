# --- Generale ---------------------------------------------------------------
NODE_ENV=production
PORT=3000
BASE_URL=https://elearning.ateneo.it
# true se l'app è dietro un reverse proxy (nginx, Apache, ecc.) che termina HTTPS
TRUST_PROXY=true
# Stringa casuale lunga (almeno 32 caratteri): openssl rand -hex 32
SESSION_SECRET=
SESSION_MAX_AGE_HOURS=12
# Cartella dove vengono salvati database e file caricati
DATA_DIR=./data
MAX_UPLOAD_MB=200

# --- Aspetto ---------------------------------------------------------------
UNIVERSITY_NAME=Università degli Studi
UNIVERSITY_SHORT_NAME=UniSTC
PLATFORM_NAME=e-Learning
PRIMARY_COLOR=#8c1d2f
ACCENT_COLOR=#c8a24a

# --- Chi può entrare -------------------------------------------------------
# Domini email istituzionali ammessi (separati da virgola). Obbligatorio in produzione.
ALLOWED_EMAIL_DOMAINS=studenti.ateneo.it,ateneo.it
# Email che diventano automaticamente amministratori al primo accesso
ADMIN_EMAILS=mario.rossi@studenti.ateneo.it

# --- Autenticazione --------------------------------------------------------
# oidc   = OpenID Connect (Microsoft Entra ID / Google Workspace / Keycloak / IdP d'Ateneo)
# header = SAML/Shibboleth (IDEM) tramite Service Provider davanti all'app
# dev    = login simulato (solo sviluppo, vietato in produzione)
AUTH_MODE=oidc

# Esempio Microsoft Entra ID (Office 365 d'Ateneo):
#   OIDC_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
# Esempio Google Workspace:
#   OIDC_ISSUER=https://accounts.google.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://elearning.ateneo.it/auth/callback
OIDC_SCOPES=openid email profile
# Facoltativo: claim aggiuntivo da verificare, es. solo studenti
# OIDC_REQUIRED_CLAIM=eduperson_affiliation
# OIDC_REQUIRED_CLAIM_VALUES=student

# Solo per AUTH_MODE=header (nomi degli header impostati dallo SP Shibboleth)
# AUTH_HEADER_EMAIL=mail
# AUTH_HEADER_NAME=displayName
# AUTH_HEADER_ID=eppn
# AUTH_HEADER_LOGIN_PATH=/auth/sso
