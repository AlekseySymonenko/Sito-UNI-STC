<%- include('head') %>
<body class="app">
<%- include('icons') %>
<a class="skip-link" href="#main">Vai al contenuto</a>

<aside class="sidebar" id="sidebar">
  <a class="brand" href="/">
    <svg class="brand-crest"><use href="#i-crest"/></svg>
    <span class="brand-text">
      <strong><%= uni.platformName %></strong>
      <small><%= uni.name %></small>
    </span>
  </a>

  <nav class="nav">
    <p class="nav-label">Didattica</p>
    <a href="/" class="<%= path === '/' ? 'active' : '' %>"><svg><use href="#i-home"/></svg>Dashboard</a>
    <a href="/courses" class="<%= path.startsWith('/courses') ? 'active' : '' %>"><svg><use href="#i-book"/></svg>Corsi</a>
    <a href="/search" class="<%= path === '/search' ? 'active' : '' %>"><svg><use href="#i-search"/></svg>Cerca materiali</a>
    <a href="/me/uploads" class="<%= path === '/me/uploads' ? 'active' : '' %>"><svg><use href="#i-upload"/></svg>I miei caricamenti</a>
    <% if (isAdmin) { %>
      <p class="nav-label">Gestione</p>
      <a href="/admin" class="<%= path.startsWith('/admin') ? 'active' : '' %>"><svg><use href="#i-shield"/></svg>Amministrazione</a>
    <% } %>
  </nav>

  <div class="sidebar-foot">
    <svg><use href="#i-lock"/></svg>
    <span>Accesso riservato alla comunità studentesca dell'Ateneo</span>
  </div>
</aside>
<div class="sidebar-backdrop" data-close-sidebar></div>

<div class="main-wrap">
  <header class="topbar">
    <button class="icon-btn menu-btn" type="button" data-toggle-sidebar aria-label="Apri menu"><svg><use href="#i-menu"/></svg></button>
    <form class="top-search" action="/search" method="get" role="search">
      <svg><use href="#i-search"/></svg>
      <input type="search" name="q" placeholder="Cerca lezioni, dispense, registrazioni…" aria-label="Cerca" value="<%= typeof q !== 'undefined' && path === '/search' ? q : '' %>">
    </form>
    <div class="user-menu">
      <button class="user-btn" type="button" data-toggle-menu aria-haspopup="true" aria-expanded="false">
        <span class="avatar"><%= initials(user.name) %></span>
        <span class="user-meta">
          <strong><%= user.name %></strong>
          <small><%= isAdmin ? 'Amministratore' : 'Studente' %></small>
        </span>
      </button>
      <div class="dropdown" role="menu">
        <div class="dropdown-head">
          <strong><%= user.name %></strong>
          <small><%= user.email %></small>
        </div>
        <a href="/me/uploads" role="menuitem"><svg><use href="#i-upload"/></svg>I miei caricamenti</a>
        <form action="/logout" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" role="menuitem"><svg><use href="#i-logout"/></svg>Esci</button>
        </form>
      </div>
    </div>
  </header>

  <main id="main" class="content">
    <% if (flash && flash.length) { %>
      <div class="flash-stack">
        <% flash.forEach(function (f) { %>
          <div class="flash flash-<%= f.type %>" role="status"><%= f.text %><button type="button" class="flash-close" aria-label="Chiudi" data-dismiss>&times;</button></div>
        <% }) %>
      </div>
    <% } %>
