<%- include('partials/top') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Catalogo</p>
    <h1>Corsi</h1>
    <p class="muted">Seleziona un insegnamento per consultarne i materiali o contribuire.</p>
  </div>
  <a class="btn btn-primary" href="/courses/new"><svg><use href="#i-plus"/></svg>Nuovo corso</a>
</div>

<form class="filter-bar" method="get" action="/courses">
  <div class="input-ic">
    <svg><use href="#i-search"/></svg>
    <input type="search" name="q" value="<%= q %>" placeholder="Filtra per nome, codice o docente">
  </div>
  <button class="btn btn-ghost" type="submit">Filtra</button>
</form>

<% if (courses.length === 0) { %>
  <div class="panel empty">
    <svg><use href="#i-book"/></svg>
    <p><%= q ? 'Nessun corso corrisponde alla ricerca.' : 'Non ci sono ancora corsi.' %></p>
    <a class="btn btn-primary" href="/courses/new"><svg><use href="#i-plus"/></svg>Crea un corso</a>
  </div>
<% } else { %>
  <div class="course-grid">
    <% courses.forEach(function (c) { %><%- include('partials/course-card', { c: c }) %><% }) %>
  </div>
<% } %>

<%- include('partials/bottom') %>
