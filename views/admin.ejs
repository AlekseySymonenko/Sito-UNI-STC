<%- include('partials/top') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Gestione piattaforma</p>
    <h1>Amministrazione</h1>
    <p class="muted">Assegna o revoca il ruolo di amministratore. Gli amministratori possono modificare i corsi ed eliminare corsi e materiali.</p>
  </div>
</div>

<section class="stats">
  <div class="stat"><span class="stat-ic"><svg><use href="#i-users"/></svg></span><div><strong><%= stats.users %></strong><small>Utenti</small></div></div>
  <div class="stat"><span class="stat-ic"><svg><use href="#i-book"/></svg></span><div><strong><%= stats.courses %></strong><small>Corsi</small></div></div>
  <div class="stat"><span class="stat-ic"><svg><use href="#i-folder"/></svg></span><div><strong><%= stats.files %></strong><small>Materiali</small></div></div>
  <div class="stat"><span class="stat-ic"><svg><use href="#i-archive"/></svg></span><div><strong><%= formatBytes(stats.bytes) %></strong><small>Spazio occupato</small></div></div>
</section>

<section class="panel">
  <div class="panel-head wrap">
    <h2>Utenti e ruoli</h2>
    <form method="get" class="inline-search">
      <svg><use href="#i-search"/></svg>
      <input type="search" name="q" value="<%= q %>" placeholder="Cerca per nome o email">
    </form>
  </div>
  <p class="muted small">Gli utenti compaiono qui dopo il loro primo accesso con le credenziali d'Ateneo.</p>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr><th>Utente</th><th>Ruolo</th><th>Caricamenti</th><th>Ultimo accesso</th><th class="right">Azioni</th></tr>
      </thead>
      <tbody>
        <% users.forEach(function (u) { %>
          <tr>
            <td>
              <div class="user-cell">
                <span class="avatar sm"><%= initials(u.name) %></span>
                <div><strong><%= u.name %><%= u.id === user.id ? ' (tu)' : '' %></strong><small><%= u.email %></small></div>
              </div>
            </td>
            <td><span class="role role-<%= u.role %>"><%= u.role === 'admin' ? 'Amministratore' : 'Studente' %></span></td>
            <td><%= u.uploads %></td>
            <td><%= formatDateTime(u.last_login) %></td>
            <td class="right">
              <form action="/admin/users/<%= u.id %>/role" method="post"
                    <% if (u.role === 'admin') { %>data-confirm="Revocare il ruolo di amministratore a <%= u.name %>?"<% } %>>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <% if (u.role === 'admin') { %>
                  <input type="hidden" name="role" value="student">
                  <button class="btn btn-ghost btn-sm" type="submit">Revoca admin</button>
                <% } else { %>
                  <input type="hidden" name="role" value="admin">
                  <button class="btn btn-primary btn-sm" type="submit"><svg><use href="#i-shield"/></svg>Rendi admin</button>
                <% } %>
              </form>
            </td>
          </tr>
        <% }) %>
        <% if (users.length === 0) { %>
          <tr><td colspan="5" class="center muted">Nessun utente trovato.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<section class="panel">
  <div class="panel-head"><h2>Registro attività</h2></div>
  <ul class="audit">
    <% audit.forEach(function (a) { %>
      <li>
        <span class="audit-action a-<%= a.action %>"><%= a.action.replace(/_/g, ' ') %></span>
        <span class="audit-text"><strong><%= a.user_name || 'Sistema' %></strong><%= a.details ? ' — ' + a.details : '' %></span>
        <time class="muted small"><%= formatDateTime(a.created_at) %></time>
      </li>
    <% }) %>
    <% if (audit.length === 0) { %><li class="muted">Nessuna attività registrata.</li><% } %>
  </ul>
</section>

<%- include('partials/bottom') %>
