<%- include('partials/top') %>

<a class="back-link" href="/courses"><svg><use href="#i-arrow-left"/></svg>Tutti i corsi</a>

<section class="course-hero cover-<%= course.color %>">
  <div class="course-hero-body">
    <span class="course-code light"><%= course.code || 'CORSO' %><%= course.year ? ' · A.A. ' + course.year : '' %></span>
    <h1><%= course.name %></h1>
    <p><%= course.teacher ? 'Docente: Prof. ' + course.teacher : 'Docente non indicato' %></p>
    <% if (course.description) { %><p class="course-desc"><%= course.description %></p><% } %>
  </div>
  <div class="course-hero-side">
    <div class="hero-count"><strong><%= total %></strong><small>materiali</small></div>
      <div class="hero-admin">
        <a class="btn btn-light btn-sm" href="#upload"><svg><use href="#i-upload"/></svg>Carica</a>
    <% if (isAdmin) { %>
        <a class="btn btn-light btn-sm" href="/courses/<%= course.id %>/edit"><svg><use href="#i-edit"/></svg>Modifica</a>
        <form action="/courses/<%= course.id %>/delete" method="post" data-confirm="Eliminare il corso «<%= course.name %>» e TUTTI i suoi <%= total %> materiali? L'operazione è irreversibile.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-light btn-sm danger" type="submit"><svg><use href="#i-trash"/></svg>Elimina</button>
        </form>
    <% } %>
      </div>
  </div>
</section>

<div class="course-layout">
  <section class="panel">
    <div class="panel-head wrap">
      <nav class="tabs" aria-label="Filtra per tipo">
        <a href="/courses/<%= course.id %>" class="<%= !kind ? 'active' : '' %>">Tutti <span><%= total %></span></a>
        <% Object.keys(KINDS).forEach(function (k) { if (!counts[k]) return; %>
          <a href="/courses/<%= course.id %>?kind=<%= k %>" class="<%= kind === k ? 'active' : '' %>"><%= KINDS[k].plural %> <span><%= counts[k] %></span></a>
        <% }) %>
      </nav>
      <form method="get" class="inline-search">
        <% if (kind) { %><input type="hidden" name="kind" value="<%= kind %>"><% } %>
        <svg><use href="#i-search"/></svg>
        <input type="search" name="q" value="<%= q %>" placeholder="Cerca nel corso">
      </form>
    </div>

    <% if (files.length === 0) { %>
      <div class="empty">
        <svg><use href="#i-folder"/></svg>
        <p><%= q || kind ? 'Nessun materiale corrisponde ai filtri.' : 'Questo corso non ha ancora materiali. Sii il primo a contribuire!' %></p>
      </div>
    <% } else { %>
      <ul class="file-list">
        <% files.forEach(function (file) { %><%- include('partials/file-item', { file: file }) %><% }) %>
      </ul>
    <% } %>
  </section>

  <aside class="panel upload-panel" id="upload">
    <h2><svg><use href="#i-upload"/></svg>Carica materiale</h2>
    <p class="muted small">PDF, immagini, audio, video e documenti. Max <%= maxUploadMb %> MB per file, fino a 20 file insieme.</p>

    <form class="upload-form" action="/courses/<%= course.id %>/upload?_csrf=<%= csrfToken %>" method="post" enctype="multipart/form-data"
          data-upload data-csrf="<%= csrfToken %>">
      <label class="dropzone" data-dropzone>
        <input type="file" name="files" multiple required accept="<%= acceptAttr %>" data-file-input>
        <svg><use href="#i-upload"/></svg>
        <strong>Trascina qui i file</strong>
        <span>oppure <u>sfoglia dal dispositivo</u></span>
      </label>
      <ul class="selected-files" data-selected></ul>

      <label>Titolo <small class="muted">(se carichi un solo file)</small>
        <input type="text" name="title" maxlength="200" placeholder="Es. Lezione 3 – Limiti e continuità">
      </label>
      <label>Descrizione <small class="muted">(facoltativa)</small>
        <textarea name="description" rows="3" maxlength="2000" placeholder="Argomenti trattati, data della lezione…"></textarea>
      </label>

      <div class="progress" data-progress hidden><div class="progress-bar" data-progress-bar></div><span data-progress-label>0%</span></div>
      <p class="form-error" data-upload-error hidden></p>

      <button class="btn btn-primary btn-block" type="submit"><svg><use href="#i-upload"/></svg>Carica</button>
      <p class="muted small center">I file caricati sono visibili a tutti gli studenti dell'Ateneo. Solo gli amministratori possono rimuoverli.</p>
    </form>
  </aside>
</div>

<%- include('partials/bottom') %>
