<% if (locals.user) { %>
<%- include('partials/top') %>
<% } else { %>
<%- include('partials/head') %>
<body class="error-page">
<%- include('partials/icons') %>
<main class="content">
<% } %>

<div class="panel error-card">
  <span class="error-code"><%= status %></span>
  <h1><%= title %></h1>
  <p class="muted"><%= message %></p>
  <a class="btn btn-primary" href="<%= locals.user ? '/' : '/login' %>"><svg><use href="#i-home"/></svg><%= locals.user ? 'Torna alla dashboard' : 'Vai all\'accesso' %></a>
</div>

<% if (locals.user) { %>
<%- include('partials/bottom') %>
<% } else { %>
</main>
</body>
</html>
<% } %>
