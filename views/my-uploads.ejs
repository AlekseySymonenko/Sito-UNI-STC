<%- include('partials/top') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Profilo</p>
    <h1>I miei caricamenti</h1>
    <p class="muted">Tutto il materiale che hai condiviso con la comunità. Per rimuovere un file contatta un amministratore.</p>
  </div>
</div>

<section class="panel">
  <% if (files.length === 0) { %>
    <div class="empty">
      <svg><use href="#i-upload"/></svg>
      <p>Non hai ancora caricato nessun file.</p>
      <a class="btn btn-primary" href="/courses"><svg><use href="#i-book"/></svg>Scegli un corso</a>
    </div>
  <% } else { %>
    <ul class="file-list">
      <% files.forEach(function (file) { %><%- include('partials/file-item', { file: file, withCourse: true, back: 'mine' }) %><% }) %>
    </ul>
  <% } %>
</section>

<%- include('partials/bottom') %>
